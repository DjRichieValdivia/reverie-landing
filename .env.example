# Copiá este archivo a .env.local y completá los dos valores para que la
# sección "Reseñas de Google" se actualice sola con el tiempo. Sin esto, el
# sitio sigue funcionando igual, mostrando 3 reseñas reales fijas.
# Instrucciones completas en el README, sección "Reseñas de Google en vivo".

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
